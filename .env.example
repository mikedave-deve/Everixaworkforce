# Copy to .env and fill in. Never commit real values.

# MongoDB (leave empty in local dev to use an embedded database in .data/mongo)
MONGODB_URI=

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_DAYS=7
JWT_EXPIRES_IN_DAYS_REMEMBER=30

# Server
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_LOGIN_URL=http://localhost:5173/login
# Leave empty: the API is served from the same origin (/api) locally and on Vercel.
VITE_API_URL=

# Email — Hostinger HTTP Mail API. Leave HOSTINGER_API_TOKEN empty to log emails instead of sending.
HOSTINGER_API_TOKEN=
HOSTINGER_MAILBOX_ADDRESS=
# The mailbox *resource ID* the Hostinger API expects in its URL (falls back to the address above).
HOSTINGER_MAILBOX_RESOURCE_ID=
EMAIL_DISPLAY_NAME=Everixa Workforce
# Where internal submissions (Information Setup, Help, etc.) are emailed to.
COMPANY_NOTIFY_EMAIL=

# Vercel Blob (file storage). Empty = files are saved to .data/blob in local dev.
BLOB_READ_WRITE_TOKEN=

# First administrator (created automatically if no admin exists). ADMIN_EMAIL defaults to COMPANY_NOTIFY_EMAIL.
ADMIN_EMAIL=
ADMIN_PASSWORD=
